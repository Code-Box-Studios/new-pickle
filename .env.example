DATABASE_URL="postgresql://rallypoint:rallypoint@127.0.0.1:15432/rallypoint?schema=public"
TEST_DATABASE_URL="postgresql://rallypoint:rallypoint@127.0.0.1:15432/rallypoint_test?schema=public"
JWT_SECRET="dev-secret-change-in-production"
APP_URL="http://localhost:3000"
HOLD_MINUTES="10"
NODE_ENV="development"
PAYLOAD_SECRET="replace-with-a-random-secret-at-least-32-characters"
# Optional separate database for CMS; defaults to DATABASE_URL, in schema cms.
# CMS_DATABASE_URL="postgresql://..."

# Required for real phone sign-in by SMS (Twilio Verify, six-digit service).
# Without these, development displays a local verification code; production
# refuses phone sign-in and offers the existing email option.
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_VERIFY_SERVICE_SID="VA..."
# PHONE_AUTH_PROXY_SECRET="a-private-random-secret-shared-only-with-your-reverse-proxy"
