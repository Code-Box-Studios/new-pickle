# Local PostgreSQL; replace with Supabase connection strings for hosted use.
DATABASE_URL="postgresql://rallypoint:rallypoint@127.0.0.1:15432/rallypoint?schema=public"
DIRECT_URL="postgresql://rallypoint:rallypoint@127.0.0.1:15432/rallypoint?schema=public"
TEST_DATABASE_URL="postgresql://rallypoint:rallypoint@127.0.0.1:15432/rallypoint_test?schema=public"
APP_URL="http://localhost:3000"
HOLD_MINUTES="10"
# Temporary public preview without private database/storage connections.
APP_PREVIEW_MODE="false"
PAYLOAD_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Supabase dashboard > Connect / API keys. Publishable key is safe for clients.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace-me"
# Server-only secret for private file storage. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_replace-me"
SUPABASE_STORAGE_BUCKET="pikol-uploads"
# Payload needs a direct or Supavisor SESSION connection (port 5432).
# It must not use Prisma's transaction-pool URL on port 6543.
# Defaults to DIRECT_URL, then DATABASE_URL, in schema cms.
# CMS_DATABASE_URL="postgresql://..."

# Local files only for development/tests. Production always uses Supabase.
# STORAGE_PROVIDER="local"
# Optional trusted proxy proof for a separate SMS budget per client IP.
# Without this, untrusted requests share a 20 sends/hour application budget.
# PHONE_AUTH_PROXY_SECRET="replace-with-a-private-random-secret"
# Separate private encryption key for the optional Sentry connector.
# SENTRY_CRED_SECRET="replace-with-a-private-random-secret"

# PayMongo hosted payments are prepared but disabled until merchant verification.
# Apply the PayMongo migration before setting LEDGER_READY=true. Keep settlement
# credentials and LEDGER_READY after disabling creation so pending payments settle.
PAYMONGO_ENABLED="false"
PAYMONGO_LEDGER_READY="false"
PAYMONGO_MODE="test"
PAYMONGO_MERCHANTS="[]"
# JSON example (Pikol DB IDs, not Supabase Auth IDs):
# [{"alias":"my-venue","ownerId":"owner-user-id","venueIds":["venue-id"],"methods":["gcash","paymaya","qrph"],"secretKeyEnv":"PAYMONGO_SECRET_KEY","webhookSecretEnv":"PAYMONGO_WEBHOOK_SECRET"}]
# PAYMONGO_SECRET_KEY="sk_test_..."
# PAYMONGO_WEBHOOK_SECRET="webhook-signing-secret-from-paymongo"
# Private >=32-character token for the scheduled reconciliation endpoint.
# CRON_SECRET="replace-with-a-private-random-secret"
